# =============================================================================
# Akto eBPF bcc — single place for bundle env (copied to ${EBPF_ROOT}/.env in tarball).
# =============================================================================
#
# EBPF_ROOT — install directory for this bundle (.env, logs, ebpf-logging cwd).
# HOST_MAPPING — prefix for host paths like /proc, /sys (see trafficUtil/utils.ResolveHostPath).
#
# Replace <kafka-ip> with your broker host or DNS name before starting.

EBPF_ROOT=/ebpf
HOST_MAPPING=/

# Bare-metal bundle: file logging + rotation in ebpf-bcc-run.sh (supervisor + ebpf-logging).
ENABLE_LOGS=false
LOG_FILE=/ebpf/dump.log

# Optional memory cap in integer MiB (mebibytes): 4 GiB -> 4096.
# MEM_LIMIT=4096

GOMAXPROCS=4
AKTO_TRAFFIC_BATCH_TIME_SECS=10
AKTO_TRAFFIC_BATCH_SIZE=100
AKTO_KAFKA_BROKER_MAL="cb-pre-AktoN-OGUar9jqUTrk-9939371dffa03ea1.elb.us-east-2.amazonaws.com:9092"
TRAFFIC_MAX_ACTIVE_CONN=1000000
PROBE_ALL_PID=true
DEBUG_URLS="sample"
# todo fix code is this fine ? 
HOST_MAPPING="/proc"
AKTO_LOG_LEVEL=WARN
# todo leave this ?
UPROBE_POLL_INTERVAL=120