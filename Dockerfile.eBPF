# syntax=docker/dockerfile:1

# ── Runtime base (target arch) ───────────────────────────────────────────────
# clang/bpftool are needed at container start-up to compile the BPF object
# against the running kernel's BTF (/sys/kernel/btf/vmlinux).
FROM alpine:3.22 AS base
USER root
RUN apk add --no-cache \
    clang \
    llvm \
    libbpf-dev \
    bpftool \
    linux-headers \
    build-base

# ── Go builder (always runs on the BUILD host's native arch) ─────────────────
# Using --platform=$BUILDPLATFORM lets Docker run this stage natively
# (no QEMU emulation). Go's built-in cross-compilation produces the binary
# for the TARGET arch via GOARCH / GOOS env vars.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder

ARG TARGETARCH
ARG TARGETOS=linux

WORKDIR /src
COPY ebpf ./ebpf
COPY trafficUtil ./trafficUtil

WORKDIR /src/ebpf
RUN go mod download
RUN GOARCH=${TARGETARCH} GOOS=${TARGETOS} go build -o ebpf-logging

# ── Final image (target arch) ─────────────────────────────────────────────────
FROM base

WORKDIR /ebpf
COPY --from=builder /src/ebpf/ebpf-logging /ebpf/ebpf-logging

# BPF source + Makefile — compiled at container start against the running
# kernel's BTF via `make generate` in ebpf-run.sh.
COPY ebpf/kernel/module.bpf.c /ebpf/kernel/module.bpf.c
COPY ebpf/Makefile /ebpf/Makefile

COPY ebpf-run.sh /ebpf/ebpf-run.sh
RUN chmod +x /ebpf/ebpf-run.sh

CMD "./ebpf-run.sh"
