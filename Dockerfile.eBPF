FROM golang:1.24-alpine

USER root

# Install all dependencies (cached layer - rarely changes)
RUN apk add --no-cache bcc-tools bcc-dev bcc-doc linux-headers build-base perf

# Set working directory first
WORKDIR /ebpf

# Copy trafficUtil first (required by go.mod replace directive)
COPY trafficUtil ../trafficUtil

# Copy only go.mod and go.sum first for better caching
COPY ebpf/go.mod ebpf/go.sum ./

# Download Go dependencies (cached layer - only rebuilds if go.mod/go.sum changes)
RUN go mod download

# Apply sed modifications to downloaded modules (combined into single RUN)
RUN sed -i "s/\"p_/\"akto_p_/g" ~/go/pkg/mod/github.com/iovisor/gobpf@v0.2.1-0.20221005153822-16120a1bf4d4/bcc/module.go && \
    sed -i "s/\"r_/\"akto_r_/g" ~/go/pkg/mod/github.com/iovisor/gobpf@v0.2.1-0.20221005153822-16120a1bf4d4/bcc/module.go && \
    sed -i "s/attachUProbe(/AttachUProbeInternal(/g" ~/go/pkg/mod/github.com/iovisor/gobpf@v0.2.1-0.20221005153822-16120a1bf4d4/bcc/module.go && \
    sed -i "s/resolveSymbolPath(/ResolveSymbolPath(/g" ~/go/pkg/mod/github.com/iovisor/gobpf@v0.2.1-0.20221005153822-16120a1bf4d4/bcc/symbol.go && \
    sed -i "s/resolveSymbolPath(/ResolveSymbolPath(/g" ~/go/pkg/mod/github.com/iovisor/gobpf@v0.2.1-0.20221005153822-16120a1bf4d4/bcc/module.go

# Now copy source code (changes frequently - invalidates cache from here down)
COPY ebpf/ ./
COPY trafficUtil ../trafficUtil

# Build the application
RUN go build -o ebpf-logging

# Copy kernel module and run script
COPY ebpf/kernel/module.cc ./kernel/module.cc
COPY ebpf-run.sh ./ebpf-run.sh
RUN chmod +x ./ebpf-run.sh

CMD ["./ebpf-run.sh"]
