# syntax=docker/dockerfile:1

# ── BPF compiler (CO-RE: compile once, run everywhere) ──────────────────────
# Compiles module.bpf.c into a relocatable .o at build time.
# cilium/ebpf patches CO-RE relocations at load time against the host kernel's
# BTF (/sys/kernel/btf/vmlinux) — no runtime clang needed.
FROM alpine:3.22 AS bpf-builder

ARG TARGETARCH
ARG BPF_CHUNK_SIZE_LIMIT=4

RUN apk add --no-cache clang llvm libbpf-dev bpftool linux-headers

WORKDIR /bpf
COPY ebpf/kernel/module.bpf.c kernel/module.bpf.c

RUN if [ "$TARGETARCH" = "arm64" ]; then \
      ARCH_FLAG="-D__TARGET_ARCH_arm64"; \
    else \
      ARCH_FLAG="-D__TARGET_ARCH_x86"; \
    fi && \
    mkdir -p kernel && \
    bpftool btf dump file /sys/kernel/btf/vmlinux format c > kernel/vmlinux.h && \
    clang -O2 -g -Wall -target bpf -I./kernel $ARCH_FLAG \
      -DCHUNK_SIZE_LIMIT=$BPF_CHUNK_SIZE_LIMIT \
      -c kernel/module.bpf.c -o kernel/module.bpf.o

# ── Go builder (native build host, cross-compile for target) ────────────────
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder

ARG TARGETARCH
ARG TARGETOS=linux

WORKDIR /src
COPY ebpf ./ebpf
COPY trafficUtil ./trafficUtil

WORKDIR /src/ebpf
RUN go mod download
RUN GOARCH=${TARGETARCH} GOOS=${TARGETOS} go build -o ebpf-logging

# ── Final image (no toolchain, just the binary + BPF object) ────────────────
FROM alpine:3.22

WORKDIR /ebpf
COPY --from=builder /src/ebpf/ebpf-logging /ebpf/ebpf-logging
COPY --from=bpf-builder /bpf/kernel/module.bpf.o /ebpf/kernel/module.bpf.o

COPY ebpf-run.sh /ebpf/ebpf-run.sh
RUN chmod +x /ebpf/ebpf-run.sh

CMD "./ebpf-run.sh"
