AKTO_BYTES_IN_THRESHOLD=100
AKTO_KAFKA_BROKER_MAL=localhost:29092
AKTO_TRAFFIC_BATCH_SIZE=10
AKTO_TRAFFIC_BATCH_TIME_SECS=10
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
CLOUDWATCH_READ_BATCH_SIZE=5
LOG_GROUP_ARN=
AWS_REGION=

# OpenAPI Discovery (enabled by default)
# Set to false to disable OpenAPI spec discovery from API Gateway
DISCOVER_OPENAPI_SPEC=true

# OpenAPI discovery polling interval in minutes (default: 15)
OPENAPI_DISCOVERY_INTERVAL_MINUTES=15