AKTO_K8_METADATA_CAPTURE=false
INGEST_LOGS=true
PROCESS_LOGS=false
AKTO_LOG_LEVEL=DEBUG
PRINT_BPF_LOGS=false
TRACE_COMMS=python3
MODULE_MEM_CHECK_INTERVAL=150000
AKTO_PER_CONN_CH_BUFFER_SIZE=200
DEBUG_MODE=true
DEBUG_URLS=echo
SKIP_PAIR_PROCESSING=false
AKTO_FAST_INGESTION=false
HOST_MAPPING=/
UPROBE_POLL_INTERVAL=120
PROBE_ALL_PID=true
DEBUG_URLS="test-run"
#AKTO_SYS_MEM_HARD_LIMIT=1800
#AKTO_MEM_THRESH_RESTART=1600
KAFKA_DISABLED=true
AKTO_ENABLE_PPROF=true
AKTO_SKIP_SEQUENCE_CHECK=true
AKTO_THREAT_ENABLED=false
NODE_NAME=local
